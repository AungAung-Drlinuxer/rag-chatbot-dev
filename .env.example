# Copy to .env before `docker compose up`. `.env` is git-ignored: never commit real values.

# Database password for the local stack (any long random string).
POSTGRES_PASSWORD=change-me-local-db-password

# First administrator. Created once by the `init` service; the app has no default account.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-first-admin-password

# Optional: an LLM provider key for chat answers. Without one the app still runs and the
# knowledge base still ingests; set it later in Settings -> Integrations instead.
# OPENAI_API_KEY=
