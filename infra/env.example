# Copy to infra/env and edit. `infra/scripts/render.sh` reads it.
# Everything here is a *deployment* value, never a credential.
# Real secrets go through infra/scripts/create-secrets.sh.

# Namespace the whole stack lives in.
NAMESPACE=rag-chatbot-dev

# Container registry that holds the four images (no trailing slash).
REGISTRY=harbor.drlinuxer.com/rag-chatbot-dev

# Image tags. Backend, worker and beat share one image and therefore one tag.
FRONTEND_TAG=dev-1.0.73
BACKEND_TAG=dev-1.0.61
OLLAMA_TAG=0.5.7-models
RERANK_TAG=1.0.2

# Externally reachable hostname and its TLS secret.
DOMAIN=dev-chat.drlinuxer.com
TLS_SECRET=drlinuxer-tls

# Ingress class of your cluster (`kubectl get ingressclass`). 
INGRESS_CLASS=nginx

# StorageClass for the Redis volume. Leave empty to use the cluster default.
# `kubectl get storageclass` — most managed clusters have exactly one.
STORAGE_CLASS=truenas-iscsi

# PostgreSQL volume size (CloudNativePG operator required).
POSTGRES_SIZE=5Gi

# Optional: S3 target for CloudNativePG backups. Set BACKUP_ENABLED=0 to skip the
# ObjectStore + ScheduledBackup entirely (a fresh test cluster usually does).
BACKUP_ENABLED=1
S3_ENDPOINT=https://s3.drlinuxer.com
S3_BUCKET=rag-chatbot-dev-postgres

# Optional: Alloy → Prometheus remote-write collector. Set MONITORING_ENABLED=0 to
# skip it when the target Prometheus does not exist yet.
MONITORING_ENABLED=1
# Prometheus remote-write endpoint that Alloy pushes to (must exist and accept writes).
PROM_REMOTE_WRITE=http://10.10.10.18:9090/api/v1/write
